# Copie este arquivo para .env e preencha sua chave.
# O arquivo .env real fica ignorado pelo Git.

# Google AI Studio / Gemini API
GEMINI_API_KEY=

# Opcional: ajuste para o ID exato disponivel na sua conta.
GEMMA_MODEL=gemma-4-31b-it

# Opcional: limite de tokens de saida para os testes.
GEMMA_MAX_OUTPUT_TOKENS=2048

# Opcional: timeout de rede.
GEMMA_TIMEOUT_SECONDS=180

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=180
